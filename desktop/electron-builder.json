{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.skyholdisles.game",
  "productName": "Skyhold Isles",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "!dist/sw.js",
    "desktop/main.cjs",
    "desktop/preload.cjs",
    "desktop/shellCore.cjs",
    "desktop/achievements.json",
    "package.json",
    "!node_modules/**/*",
    "node_modules/steamworks.js/**/*"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/steamworks.js/**/*"
  ],
  "win": {
    "icon": "public/icons/icon-512.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "category": "public.app-category.strategy-games",
    "icon": "public/icons/icon-512.png",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ]
  },
  "linux": {
    "category": "Game",
    "synopsis": "Hand-painted storybook tower defense across floating sky islands",
    "icon": "public/icons/icon-512.png",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ]
  }
}
